# MongoDB connection string
# Agar Shopinza wala cluster pehle se hai to WAHI use karo — nayi cluster/dollar spend
# ki zaroorat nahi. Bas connection string ke AKHIR me database ka naam "zovari" rakho
# (Shopinza wale ka naam "shopinza" hoga waha). Ek cluster me kitne bhi databases free
# me ban sakte hain, alag-alag naam se.
#
# Example: agar Shopinza ka URI aisa hai:
#   mongodb+srv://user:pass@cluster0.abcde.mongodb.net/shopinza
# to Zovari ke liye sirf itna badlo:
#   mongodb+srv://user:pass@cluster0.abcde.mongodb.net/zovari
MONGO_URI=mongodb://localhost:27017/zovari

# JWT secret (koi bhi lamba random string rakh lo)
JWT_SECRET=change_this_to_a_long_random_secret

# Server port
PORT=5000

# Frontend URL (CORS ke liye, jahan index.html/login.html run ho rahe hain)
CLIENT_URL=http://127.0.0.1:5500
